# Copy this file to .env and fill in your Supabase keys.
# Keys are in Supabase Dashboard -> Project Settings -> API

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: change the token secret (any long random string)
# JWT_SECRET=change-me-to-something-secret
