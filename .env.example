# Copy this file to .env and fill in your Supabase keys.
# Keys are in Supabase Dashboard -> Project Settings -> API Keys.
# Use the PUBLISHABLE key (new format) or the legacy anon key.
# VITE_ keys are safe to expose in the browser.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here
